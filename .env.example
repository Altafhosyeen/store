# Backend API base URL. Falls back to window.location.origin when unset.
VITE_BACKEND_URL=http://localhost:8000

# development | staging | production
VITE_ENVIRONMENT=development

# Cookie names for the auth tokens (must match backend expectations).
VITE_ACCESS_TOKEN_ALIAS=AccessToken
VITE_REFRESH_TOKEN_ALIAS=RefreshToken

# Set true when served over HTTPS so auth cookies are marked Secure.
VITE_SSL_ENABLED=false

# Default page size for paginated tables.
VITE_PAGINATION_SIZE=12

# Serve the app from mock data instead of the backend (development only).
# Ignored when VITE_ENVIRONMENT=production.
VITE_ENABLE_MOCK=false
